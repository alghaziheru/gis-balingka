{
  "name": "gis-balingka",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Open-source public spatial data viewer for Nagari Balingka (Kab. Agam, West Sumatra) and configurable Indonesian village/nagari terrain, hydrology, and drainage infrastructure.",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alghaziheru/gis-balingka.git"
  },
  "homepage": "https://github.com/alghaziheru/gis-balingka#readme",
  "bugs": {
    "url": "https://github.com/alghaziheru/gis-balingka/issues"
  },
  "keywords": [
    "gis",
    "maplibre",
    "hydrology",
    "demnas",
    "hand",
    "open-data",
    "indonesia",
    "nagari",
    "desa",
    "civic-tech"
  ],
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepare-data": "node scripts/prepare-data.mjs",
    "reset-region": "node scripts/reset-region.mjs",
    "sync-seed": "node scripts/sync-seed.mjs",
    "import-seed": "node scripts/import-seed.mjs",
    "sensitivity": "node scripts/run-sensitivity.mjs",
    "benchmark": "node scripts/run-benchmarks.mjs",
    "test": "node --test tests/hydrology.test.mjs tests/api.test.mjs",
    "verify": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "geotiff": "^3.0.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
