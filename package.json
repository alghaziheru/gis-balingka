{
  "name": "gis-balingka",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Open-source community GIS web application for Nagari Balingka (Kab. Agam, West Sumatra) terrain, drainage conditions, and flash-flood (galodo) mitigation.",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepare-data": "node scripts/prepare-data.mjs",
    "sync-seed": "node scripts/sync-seed.mjs",
    "import-seed": "node scripts/import-seed.mjs",
    "test": "node --test tests/hydrology.test.mjs tests/api.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "geotiff": "^3.0.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
