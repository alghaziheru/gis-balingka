# Optional passphrase to lock waterway editing & audit revert on public VPS deployments.
# Leave empty on localhost to enable immediate editing without a prompt.
ADMIN_PASSPHRASE=

# HTTP server listen host/port (used by npm start / server)
HOST=0.0.0.0
PORT=8787

# Optional custom SQLite database file location
BALINGKA_DB_PATH=./data/balingka.db

# Optional custom high-resolution drone/orthophoto XYZ tile template for Satellite mode
VITE_CUSTOM_IMAGERY_URL=
VITE_CUSTOM_IMAGERY_MAXZOOM=20
